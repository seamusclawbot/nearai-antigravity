#!/usr/bin/env bash
# NEAR AI Agent Runner Bridge for Antigravity
# Generated by nearai_agy.py pro setup
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOL_PY=""

if [[ -n "${NEARAI_AGY_PY:-}" && -f "${NEARAI_AGY_PY}" ]]; then
    TOOL_PY="${NEARAI_AGY_PY}"
elif [[ -f "${SCRIPT_DIR}/nearai_agy.py" ]]; then
    TOOL_PY="${SCRIPT_DIR}/nearai_agy.py"
elif [[ -f "${SCRIPT_DIR}/../nearai_agy.py" ]]; then
    TOOL_PY="${SCRIPT_DIR}/../nearai_agy.py"
elif [[ -f "${SCRIPT_DIR}/../../nearai_agy.py" ]]; then
    TOOL_PY="${SCRIPT_DIR}/../../nearai_agy.py"
elif command -v nearai-agy >/dev/null 2>&1; then
    exec nearai-agy pro exec "$@"
elif command -v nearai_agy.py >/dev/null 2>&1; then
    TOOL_PY="$(command -v nearai_agy.py)"
else
    printf '%s\n' "nearai-agent-runner: cannot find nearai_agy.py (set NEARAI_AGY_PY or add to PATH)" >&2
    exit 1
fi

if command -v python3 >/dev/null 2>&1; then
    PY="python3"
else
    PY="python"
fi

exec "${PY}" "${TOOL_PY}" pro exec "$@"
